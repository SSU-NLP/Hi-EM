# Hi-EM 환경변수 템플릿 (cp .env.example .env → .env에 키 채우기, .env는 .gitignored)
# 자동 로드: entry point 스크립트들이 from dotenv import load_dotenv; load_dotenv()
#
# Default 구성: LLM = Crts 프록시 (Qwen/Qwen3.5-9B), Embedding = Crts 프록시 (bge-base).

# ============================================================================
# 1) LLM 자격증명 (OpenAI-compatible)
# ============================================================================
# Crts 프록시 (api.ssunlp.co.kr) — Qwen/Qwen3.5-9B
#   ⚠️ Crts 는 streamed chat 요청에 500 → HIEM_LLM_STREAM=false 필수
#   ⚠️ Qwen3.5-9B 는 reasoning model — <think> 블록을 안 끊으면 visible content 가
#      비어나올 수 있음 → HIEM_NO_THINKING=true 가 같이 켜져야 함
OPENAI_API_KEY=lab-...
OPENAI_BASE_URL=https://api.ssunlp.co.kr/v1
HIEM_LLM_STREAM=false

# 대안 — vLLM 로컬 (학교 GPU 서버, 살아있을 때만)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://210.222.65.89:8100/v1
# HIEM_LLM_STREAM=true

# ============================================================================
# 2) Hi-EM LLM 호출 default (CLI 인자가 우선)
# ============================================================================
# Crts 는 OpenRouter-style slug (lowercase, dot, no Instruct suffix) 사용
HIEM_MODEL=qwen/qwen3.5-9b
HIEM_JUDGE_MODEL=qwen/qwen3.5-9b    # 미설정 시 HIEM_MODEL 사용
HIEM_RUN_MAX_TOKENS=4096             # hypothesis 생성 (Qwen <think> + answer)
HIEM_JUDGE_MAX_TOKENS=512            # judge 응답 (think + yes/no)
HIEM_TEMPERATURE=0.7

# 미설정 = auto (cuda → mps → cpu) — 명시: cuda / mps / cpu
HIEM_DEVICE=

# Qwen3 reasoning model 의 <think> 블록 차단 (chat_template_kwargs.enable_thinking=False).
# Crts + Qwen3.5-9B 조합에서는 필수 — 안 켜면 reasoning_tokens 로 다 소비돼 빈 답 나옴.
HIEM_NO_THINKING=true

# Streaming 토글은 Section 1 에서 endpoint 별로 설정.
# HIEM_LLM_STREAM=true   → SSE 스트림 (TTFT / TPOT latency 측정 가능)
# HIEM_LLM_STREAM=false  → 비스트림 단일 응답 (TTFT/TPOT 0.0, gen_sec 만 기록)
# vLLM 은 true 그대로, Crts 는 false (스트림 500 에러 회피).

# ============================================================================
# 3) Embedding backend (Phase 4 query encoder)
# ============================================================================
# local: sentence-transformers (default: bge-base-en-v1.5, dim 768)
# api  : OpenAI-compatible /v1/embeddings — Crts 프록시(default) 등
#
# ⚠️ LLM 과 임베딩이 같은 Crts provider 라도 키/모델 정의는 별도 필수.
#    HIEM_EMBEDDING_API_KEY / HIEM_EMBEDDING_BASE_URL 을 명시 안 하면 OPENAI_* 로
#    fallback 되어 chat endpoint 로 embedding 을 보내려다 깨짐.

# 권장) Crts + bge-base — Phase 1 sweep (α=10, λ=1, σ²₀=0.01) 그대로 재사용
HIEM_EMBEDDING_BACKEND=api
HIEM_EMBEDDING_MODEL=baai/bge-base-en-v1.5
HIEM_EMBEDDING_API_KEY=lab-...
HIEM_EMBEDDING_BASE_URL=https://api.ssunlp.co.kr/v1
HIEM_EMBEDDING_DIM=768
HIEM_EMBEDDING_DIMENSIONS=                         # bge 는 truncation 미지원 → 비움

# ============================================================================
# 4) W&B 로깅 (선택, 키 없으면 wandb는 no-op)
# ============================================================================
# WANDB_API_KEY=
# WANDB_PROJECT=hi-em-phase4
